# Shared business platform using the existing Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Existing Premium Remodel organizations.id. Used for legacy legal agreement
# and as the fallback organization for legacy public intake and Stripe config.
SUPABASE_ORGANIZATION_ID=
# Used for invitation destinations.
APP_URL=http://localhost:3000
# Only needed by the migration/backup scripts, not the running web app.
DATABASE_URL=
# Server-only workflow worker authentication. Use a long random value.
CRON_SECRET=
# Server-only Discord product council integration. Rotate exposed bot tokens
# before use. Channel IDs map to #ideas, #approval, and the existing #cicd.
DISCORD_PRODUCT_APPLICATION_ID=
DISCORD_PRODUCT_BOT_TOKEN=
DISCORD_PRODUCT_PUBLIC_KEY=
DISCORD_PRODUCT_GUILD_ID=
DISCORD_PRODUCT_IDEAS_CHANNEL_ID=
DISCORD_PRODUCT_APPROVAL_CHANNEL_ID=
DISCORD_PRODUCT_CICD_CHANNEL_ID=
# Optional comma-separated Discord user IDs. Discord administrators and users
# with Manage Server are also accepted as product reviewers.
DISCORD_PRODUCT_REVIEWER_IDS=
# Keep both values on "shadow" until the workflow migration and parity suite
# pass in a non-production database. Set both to "execute" for live cutover.
WORKFLOW_ENGINE_MODE=shadow
WORKFLOW_CURRENT_FLOWS_MODE=shadow
# Server only: used for renovation previews. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Server only: company Twilio connection. Never prefix with NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional dedicated 32-byte base64url key for new organization Twilio connections.
# When empty, GOOGLE_TOKEN_ENCRYPTION_KEY is used; keep it for existing connections.
TWILIO_TOKEN_ENCRYPTION_KEY=
# Server only: signs revocable client project links.
CLIENT_PORTAL_SECRET=
# Server only: Google OAuth web client and a random 32-byte base64url key.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional separate OAuth client for Gmail sending; if omitted, the Calendar
# OAuth client above is reused. Add /api/google-mail/callback as a redirect URI.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# Optional dedicated OAuth client for Google Business Profile reviews.
# Add /api/google-business/callback as an authorized redirect URI.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Server only: Stripe Checkout and signed payment confirmation webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional per-organization Stripe accounts. JSON keyed by organization UUID:
# {"uuid":{"secretKey":"sk_...","webhookSecret":"whsec_..."}}
STRIPE_ACCOUNTS_JSON=
