# Premium Remodel uses the company's existing Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Existing Premium Remodel organizations.id; restrict this deployment to it.
SUPABASE_ORGANIZATION_ID=
# Used for invitation destinations.
APP_URL=http://localhost:3000
# Only needed by the migration/backup scripts, not the running web app.
DATABASE_URL=
# Server only: used for renovation previews. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Server only: company Twilio connection. Never prefix with NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Server only: signs revocable client project links.
CLIENT_PORTAL_SECRET=
# Server only: Google OAuth web client and a random 32-byte base64url key.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
