{
  "expo": {
    "name": "ServiceBuddy Field",
    "slug": "servicebuddy-field",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/servicebuddy-icon.png",
    "scheme": [
      "servicebuddyfield",
      "premiumremodelfield"
    ],
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "f72e6ff9-2602-4223-ac1c-e018497fd9fc"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.premiumremodel.field",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSCameraUsageDescription": "ServiceBuddy uses the camera and LiDAR sensor to create room measurements and 3D models for your company's quotes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.premiumremodel.field",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#071d33",
        "foregroundImage": "./assets/servicebuddy-adaptive.png",
        "monochromeImage": "./assets/servicebuddy-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ServiceBuddy uses your location while you work to place visits accurately and show your active position on your company's map.",
          "locationAlwaysAndWhenInUsePermission": "ServiceBuddy uses your location during an active shift so your company's map can stay current when your phone is locked or you switch apps.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow ServiceBuddy to securely access your saved work session."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/servicebuddy-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/servicebuddy-icon.png"
    },
    "owner": "premiumremodels-team"
  }
}
